{
  "manifest_version": 2,
  "name": "Fluent History Popup",
  "version": "1.2.39",
  "description": "Fluent-style Edge history popup viewer",
  "browser_specific_settings": {
    "gecko": {
      "id": "fluent-history-popup@customextension.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "history",
    "sessions",
    "tabs"
  ],
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
