{
  "manifest_version": 2,
  "name": "Fluent Downloads Popup",
  "version": "1.2.39",
  "description": "Fluent-style Edge downloads popup manager",
  "browser_specific_settings": {
    "gecko": {
      "id": "fluent-downloads-popup@customextension.com",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "permissions": [
    "downloads",
    "downloads.open",
    "storage"
  ],
  "background": {
    "scripts": ["background.js"],
    "persistent": true
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
