{
  "manifest_version": 3,
  "incognito": "spanning",
  "name": "Edge Downloads",
  "version": "1.3.6",
  "description": "Popup quản lý lượt tải xuống thiết kế Fluent phong cách Edge",
  "permissions": [
    "downloads",
    "downloads.open",
    "downloads.ui",
    "offscreen",
    "storage",
    "scripting"
  ],
  "content_scripts": [
    {
      "matches": [
        "http://*/*",
        "https://*/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon_dark16.png",
      "32": "icon_dark32.png",
      "48": "icon_dark48.png"
    }
  },
  "icons": {
    "16": "icon_dark16.png",
    "32": "icon_dark32.png",
    "48": "icon_dark48.png",
    "128": "icon_dark128.png"
  }
}
