{
  "manifest_version": 3,
  "name": "Edge History",
  "version": "1.0.8",
  "description": "Popup xem lịch sử thiết kế Fluent phong cách Edge",
  "permissions": [
    "history",
    "favicon",
    "sessions",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": "icon.svg"
  },
  "icons": {
    "16": "icon.svg",
    "32": "icon.svg",
    "48": "icon.svg",
    "128": "icon.svg"
  }
}
