{
  "manifest_version": 3,
  "incognito": "split",
  "name": "Edge History",
  "version": "1.2.18",
  "description": "Popup xem lịch sử thiết kế Fluent phong cách Edge",
  "permissions": [
    "history",
    "favicon",
    "sessions",
    "tabs"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "32": "icon32.png",
      "48": "icon48.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "32": "icon32.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
